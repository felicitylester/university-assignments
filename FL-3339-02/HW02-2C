.data
prompt_msg1: .asciiz "Enter a variable for x: "
prompt_msg2: .asciiz "Enter a variable for n: "
result_msg: .asciiz "The value of power(x, n): "
newline: .asciiz "\n"

.text
.globl power
.globl main

main:
	# user input x
	li $v0, 4
	la $a0, prompt_msg1
	syscall
	
	# read (x)
	li $v0, 5
	syscall
	move $a0, $v0    # move user input to $a0 (x)
    
    	# user input n
    	li $v0, 4
    	la $a0, prompt_msg2
    	syscall
    
    	# read(n)
    	li $v0, 5
    	syscall
    	move $a1, $v0    # move user input to $a1 (n)

    	# call power function: power(x, n)
    	jal power

    	li $v0, 4
    	la $a0, result_msg
    	syscall

    	# print result value
    	li $v0, 1
    	syscall
    	
    	li $v0, 4
    	la $a0, newline
    	syscall

    	# exit
    	li $v0, 10
    	syscall

power:
	addi $sp, $sp, -16   # space on stack
	sw $ra, 12($sp)      # save return address
	sw $a1, 8($sp)       # save n
	sw $a0, 4($sp)       # save x
    
    	beq $a1, $zero, base_case

	addi $a1, $a1, -1   # decrement n
    	jal power           # recursive call

    	lw $a0, 4($sp)      # restore x
    	mul $v0, $a0, $v0   # x * power(x, n-1)
    
    	j end_power

base_case:
	li $v0, 1
    	j end_power

end_power:
    	lw $ra, 12($sp)		# restore return address
    	lw $a1, 8($sp)          # restore n
    	lw $a0, 4($sp)          # restore x
    	addi $sp, $sp, 16       # restore stack space
    	jr $ra
