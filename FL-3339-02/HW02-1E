.data
	prompt_size: .asciiz "Enter size of vectors: "
    	prompt_vecA: .asciiz "Enter values of vector A: "
    	prompt_vecB: .asciiz "Enter values of vector B: "
    	prompt_result: .asciiz "Result of vectors: "
    	newline: .asciiz "\n"

	size: .word 0
	vec_A: .space 100
	vec_B: .space 100

.text
.globl main

main:
	# prompt and read user input for size 
	li $v0, 4
	la $a0, prompt_size  # load size
	syscall
	
	# read one integer at a time
	li $v0, 5
	syscall
	sw $v0, size	# store size
	
	# Read elements for vector A
	la $s0, vec_A
	li $t4, 0
	lw $t3, size  	# load size
	
	li $v0, 4
	la $a0, prompt_vecA
	syscall

read_loopA:
	beq $t4, $t3, read_vecB
	
	li $v0, 5
	syscall
	sw $v0, 0($s0)	# store in vec_A[i]

	addi $s0, $s0, 4
	addi $t4, $t4, 1
	j read_loopA

read_vecB:
	la $s1, vec_B
	li $t4, 0  # reset [i]
	
	li $v0, 4
	la $a0, prompt_vecB
	syscall

read_loopB:
	beq $t4, $t3, compute_result
	
	li $v0, 5
	syscall
	sw $v0, 0($s1)	# store in vec_B[i]
	
	addi $s1, $s1, 4
	addi $t4, $t4, 1
	j read_loopB

compute_result:
	la $s0, vec_A	# load mem address A
	la $s1, vec_B	# point to start of vec
	lw $t3, size
	li $t4, 0
	li $v0, 0  	# result = 0

result_loop:
	beq $t4, $t3, print_result  # i == size, print result

    	lw $t0, 0($s0)  # load vec_A[i]
    	lw $t1, 0($s1)  # load vec_B[i]
    	
    	mul $t2, $t0, $t1  # multiply A[i] * B[i]
    	add $t5, $t5, $t2  # compute result
    	
    	addi $s0, $s0, 4
    	addi $s1, $s1, 4
    	addi $t4, $t4, 1   # increment loop counter
    	j result_loop

print_result:
	li $v0, 4
	la $a0, prompt_result
	syscall
	
	# result value
	li $v0, 1
	move $a0, $t5
	syscall
	
	li $v0, 4
	la $a0, newline
    	syscall

	# exit program
	li $v0, 10
	syscall