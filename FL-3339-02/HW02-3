.data

prompt: .asciiz "Enter string: "
output: .asciiz " reversed is "
newline: .asciiz "\n"
space: .asciiz " "
buffer: .space 50  # space for user input

.text
.globl main


main:
	li $v0, 4
	la $a0, prompt
	syscall
	
	li $v0, 8
	la $a0, buffer
	li $a1, 50
	syscall

	# print user string
	li $v0, 4
	la $a0, buffer
	syscall

	# print input
	li $v0, 4
	la $a0, buffer
	syscall

	# print " reversed is "
	li $v0, 4
	la $a0, output
	syscall
	
	# get length of string
	li $t2, 0
	
strLen:
    	lb $t0, buffer($t2)        # load byte from buffer into $t0
    	beqz $t0, reverse_string
    	addi $t2, $t2, 1           # increment counter (t2)
    	j strLen 

reverse_string:
    	sub $t2, $t2, 1
    	li $v0, 11	# print character
    
reverse_loop:
    	lb $a0, buffer($t2)
    	beqz $a0, print_newline
    	syscall
    	sub $t2, $t2, 1         # move to the previous character
    	j reverse_loop
    
print_newline:	# print newline
	li $v0, 4
	la $a0, newline
	syscall
	
	# exit program
	li $v0, 10
	syscall
