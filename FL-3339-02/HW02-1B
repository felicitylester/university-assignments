.data
	vec_1: .word 1 , 2 , 3 , 4
	vec_2: .word 5 , 6 , 7 , 8
	size: .word 4		#integer size of 4

.text
.globl main

main:
	# Initialize result register
	add $v0, $zero, $zero	# result = 0
    
    	# Load base addresses of vectors
	la $s0, vec_1
	la $s1, vec_2
	lw $t3, size   # load size of vectors (4)
	
	# Initialize loop counter
	add $t4, $zero, $zero  # i = 0
    
	# Loop through each element of the vectors
loop:
	# Check loop condition
	beq $t4, $t3, end  # if i == size, exit loop
	
	# Load elements from vector 1 & 2
	lw $t0, 0($s0)
	lw $t1, 0($s1)

        mul $t2, $t0, $t1  # Multiply elements

        add $v0, $v0, $t2  # Add to result
        
        # Increment addresses to move to the next elements
        addi $s0, $s0, 4
        addi $s1, $s1, 4
        addi $t4, $t4, 1  # i++

    	# Repeat loop
    	j loop

end:
    # Exit program
    li $v0, 10
    syscall